**/*.local.*
**/*.local

# Local credentials and TLS material; never rely on ignores alone for safety.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
secrets/
credentials/
certs/
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
*htpasswd*
id_rsa*
id_ed25519*
*.token

# Test output: do not publish screenshots, traces, reports or downloaded browsers.
test-results/
playwright-report/
blob-report/
coverage/
screenshots/
artifacts/
.browser-cache/
.browser-libs/
playwright/.cache/
*.png
*.jpg
*.jpeg

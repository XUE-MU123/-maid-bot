# Runtime state, conversation records, databases, logs, caches and dependencies.
data/
logs/
cache/
node_modules/
.npm/
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.log
*.pid

# Source-only publication: rebuild and publish UI locally.
/web/
/frontend/dist/
*.tsbuildinfo

# Snapshots, archives, local exports and private deployment history.
.backups/
backups/
backup/
version_history/
*.bak
*.bak-*
*.backup
*.tar
*.tar.gz
*.tgz
*.zip
*.sql
*.dump
